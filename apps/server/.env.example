# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Proxy: number of trusted proxy hops, or false when directly exposed.
# One load balancer/reverse proxy => 1. Never use true.
TRUST_PROXY=1

# CORS
CORS_ORIGINS=http://localhost:3000

# Firebase Admin (server-side only; never commit real values)
SECRET_FIREBASE_API_KEY=replace-me
SECRET_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
SECRET_FIREBASE_PROJECT_ID=replace-me
SECRET_FIREBASE_STORAGE_BUCKET=replace-me.appspot.com
SECRET_FIREBASE_MESSAGING_SENDER_ID=replace-me
SECRET_FIREBASE_APP_ID=replace-me
GOOGLE_APPLICATION_CREDENTIALS=./docs-firebase-admin.json

# Session JWT
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=15m

# Logging
APP_NAME=docs-server
SERVICE_VERSION=1.0.0
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_IP_MODE=anonymized
LOG_TRUST_REQUEST_ID=true
LOG_QUIET_PATHS=/api/v1/health,/health,/healthz,/livez,/readyz,/ready,/metrics
LOG_IGNORE_PATHS=
LOG_QUERY_ALLOWLIST=
LOG_GEO_ENABLED=false
