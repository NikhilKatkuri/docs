{
    "name": "@docs/server",
    "version": "1.0.0",
    "description": "",
    "main": "dist/src/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias --resolve-full-paths",
        "start": "node dist/src/server.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "check-types": "tsc --noEmit",
        "prepare:db": "pnpm prisma generate",
        "init:db": "pnpm prisma migrate dev --name init",
        "setup:db": "pnpm run prepare:db && pnpm run init:db",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "express-secure-logger": "workspace:*",
        "firebase-admin": "^14.5.0",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@docs/types": "workspace:*",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "internal-ip": "^9.0.0",
        "pino-pretty": "^13.2.0",
        "prisma": "^7.10.1",
        "tsc-alias": "^1.9.8",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.5"
    }
}
