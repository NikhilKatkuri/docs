generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    uid           String     @id
    email         String     @unique
    displayName   String
    avatarUrl     String?
    provider      String
    emailVerified Boolean    @default(false)
    status        UserStatus @default(ACTIVE)

    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    lastLoginAt  DateTime?
    lastActiveAt DateTime?
    deletedAt    DateTime?

    @@index([lastLoginAt])
    @@map("users")
}

enum UserStatus {
    ACTIVE
    SUSPENDED
    DELETED
}
